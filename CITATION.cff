    affiliation: appliedAI Institute for Europe gGmbH
  - family-names: Sliwka
    given-names: Dirk
    affiliation: University of Cologne
    orcid: "https://orcid.org/0000-0002-8026-0165"
  - family-names: Orduz
    given-names: Juan Camilo
    affiliation: PyMC Labs
  - family-names: Ding
    given-names: Wenzhi
    affiliation: The Hong Kong Polytechnic University
    orcid: "https://orcid.org/0000-0002-4784-8848"
doi: 10.5281/zenodo.15814089
identifiers:
  - type: doi
    value: 10.5281/zenodo.15814089
    description: Concept DOI (always resolves to the latest version)
repository-code: 'https://github.com/py-econometrics/pyfixest'
url: 'https://pyfixest.org/'
abstract: "A Python package for fast high-dimensional fixed-effects estimation that adapts the API design and behavioral conventions of the R package `fixest`. It provides economists and other social scientists with an efficient interface for regression models containing multiple fixed effects."
keywords:
  - 'fixed effects'
  - 'panel data'
  - 'econometrics'
  - 'statistics'
  - 'causal inference'
  - 'regression'
  - 'python'
license: MIT
references:
  - type: article
    title: "fixest: A fast and feature-rich framework for econometric estimations in R"
    authors:
      - family-names: Bergé
        given-names: Laurent R
      - family-names: Butts
        given-names: Kyle
      - family-names: McDermott
        given-names: Grant
    year: 2026
    journal: "arXiv preprint arXiv:2601.21749"
    doi: 10.48550/arXiv.2601.21749
    url: "https://arxiv.org/abs/2601.21749"
    notes: >-
      Please consider citing fixest alongside pyfixest. PyFixest
      adapts fixest's API design and behavioral conventions for Python.
